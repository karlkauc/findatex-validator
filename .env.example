# Template for `docker compose` secrets. Copy to `.env` and fill in.
# Real `.env` is gitignored; this template is committed for discoverability.

# --- Anonymous usage statistics (Postgres) -------------------------------
# Create the schema once in the target Postgres (see docs/USAGE_STATS.md). With all four
# variables set, the web app records one aggregate row per validation and
# accepts desktop POSTs at /api/usage-stats. Leave empty to keep the feature
# inert — the app still boots.
FINDATEX_WEB_USAGE_DB_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
FINDATEX_WEB_USAGE_DB_USER=
FINDATEX_WEB_USAGE_DB_PASSWORD=

# Shared secret with every desktop install (set the same value as
# FINDATEX_USAGE_TOKEN there). Generate with: openssl rand -hex 32
FINDATEX_WEB_USAGE_STATS_INGEST_TOKEN=

# --- GeoIP country derivation (MaxMind GeoLite2) ------------------------------
# Free license key from https://www.maxmind.com (Account → Manage License Keys).
# Consumed only at image BUILD time (docker compose build) by the Dockerfile
# "geoip" stage, which downloads GeoLite2-Country.mmdb into the image. Empty ⇒
# download skipped, country_code stays NULL. Build with BuildKit enabled
# (default): `docker compose build` then `docker compose up -d`.
MAXMIND_LICENSE_KEY=
