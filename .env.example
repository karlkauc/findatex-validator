# Template for `docker compose` secrets. Copy to `.env` and fill in.
# Real `.env` is gitignored; this template is committed for discoverability.

# --- Anonymous usage statistics (Neon Postgres) -------------------------------
# Create the schema once in Neon (see docs/USAGE_STATS.md). With all four
# variables set, the web app records one aggregate row per validation and
# accepts desktop POSTs at /api/usage-stats. Leave empty to keep the feature
# inert — the app still boots.
FINDATEX_WEB_USAGE_DB_URL=jdbc:postgresql://<host>.neon.tech/<db>?sslmode=require
FINDATEX_WEB_USAGE_DB_USER=
FINDATEX_WEB_USAGE_DB_PASSWORD=

# Shared secret with every desktop install (set the same value as
# FINDATEX_USAGE_TOKEN there). Generate with: openssl rand -hex 32
FINDATEX_WEB_USAGE_STATS_INGEST_TOKEN=
